<Bindings>
  <Binding name="CLICK HSCollapseButton:LeftButton" description="Collapse Tracker" category="Horizon Suite">
    if _G.HSCollapseButton and _G.HSCollapseButton:GetScript("OnClick") then _G.HSCollapseButton:GetScript("OnClick")() end
  </Binding>
  <Binding name="CLICK HSNearbyToggleButton:LeftButton" description="Toggle Nearby Group" category="Horizon Suite">
    if _G.HSNearbyToggleButton and _G.HSNearbyToggleButton:GetScript("OnClick") then _G.HSNearbyToggleButton:GetScript("OnClick")() end
  </Binding>
  <Binding name="CLICK HSAutoFocusToggleButton:LeftButton" description="Toggle Auto-Focus Closest Quest" category="Horizon Suite">
    if _G.HSAutoFocusToggleButton and _G.HSAutoFocusToggleButton:GetScript("OnClick") then _G.HSAutoFocusToggleButton:GetScript("OnClick")() end
  </Binding>
  <Binding name="CLICK HSSecureItemOverlay:LeftButton" description="Use Floating Quest Item" category="Horizon Suite">
  </Binding>
  <Binding name="HORIZONSUITE_ECHO_REPLY" description="Echo: Reply to newest" category="Horizon Suite">
    if HorizonSuite and HorizonSuite:IsModuleEnabled("echo") and HorizonSuite.Echo.Stack then HorizonSuite.Echo.Stack.ReplyToNewest() end
  </Binding>
  <Binding name="HORIZONSUITE_ECHO_STACK" description="Echo: Toggle stack" category="Horizon Suite">
    if HorizonSuite and HorizonSuite:IsModuleEnabled("echo") and HorizonSuite.Echo.Stack then HorizonSuite.Echo.Stack.Toggle() end
  </Binding>
</Bindings>
